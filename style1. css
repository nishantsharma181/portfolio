/* =========================
   ABOUT
========================= */

.about{
    padding:120px 8%;
    text-align:center;
}

.about h2{
    font-size:3rem;
    margin-bottom:30px;
}

.about p{
    max-width:900px;
    margin:auto;
    color:#94A3B8;
    line-height:2;
    font-size:18px;
}

/* =========================
   SKILLS
========================= */

.skills{
    padding:120px 8%;
}

.skills h2{
    text-align:center;
    font-size:3rem;
    margin-bottom:60px;
}

.skills-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:25px;
}

.skill-card{
    background:rgba(255,255,255,.05);

    border:1px solid rgba(255,255,255,.08);

    border-radius:20px;

    padding:30px;

    text-align:center;

    font-size:18px;
    font-weight:600;

    transition:.4s;
}

.skill-card:hover{

    transform:translateY(-10px);

    border-color:#6D5DFC;

    box-shadow:
    0 0 30px rgba(109,93,252,.35);
}

/* =========================
   PROJECTS
========================= */

.projects{
    padding:120px 8%;
}

.projects h2{
    text-align:center;
    font-size:3rem;
    margin-bottom:80px;
}

.project-card{

    display:flex;
    align-items:center;

    gap:50px;

    margin-bottom:80px;

    padding:30px;

    background:rgba(255,255,255,.05);

    border:1px solid rgba(255,255,255,.08);

    border-radius:30px;

    transition:.4s;
}

.project-card:hover{

    transform:translateY(-8px);

    box-shadow:
    0 0 35px rgba(109,93,252,.35);
}

.project-image{
    flex:1;
}

.project-image img{

    width:100%;

    border-radius:20px;

    transition:.5s;
}

.project-card:hover img{
    transform:scale(1.03);
}

.project-content{
    flex:1;
}

.project-content h3{

    font-size:2rem;

    margin-bottom:20px;
}

.project-content p{

    color:#94A3B8;

    line-height:1.8;

    margin-bottom:20px;
}

.tech{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
}

.tech span{

    padding:10px 18px;

    border-radius:50px;

    background:rgba(255,255,255,.06);

    border:1px solid rgba(255,255,255,.08);
}

/* =========================
   CONTACT
========================= */

.contact{

    padding:120px 8%;

    text-align:center;
}

.contact h2{

    font-size:3rem;

    margin-bottom:30px;
}

.contact p{

    color:#94A3B8;

    margin-bottom:30px;
}

.contact-links{

    display:flex;

    justify-content:center;

    gap:25px;
}

.contact-links a{

    text-decoration:none;

    color:white;

    padding:14px 24px;

    border-radius:12px;

    background:rgba(255,255,255,.05);

    border:1px solid rgba(255,255,255,.08);

    transition:.3s;
}

.contact-links a:hover{

    border-color:#6D5DFC;

    box-shadow:
    0 0 20px rgba(109,93,252,.4);
}

/* =========================
   FOOTER
========================= */

footer{

    text-align:center;

    padding:50px 20px;

    border-top:
    1px solid rgba(255,255,255,.08);
}

footer h3{

    color:#6D5DFC;

    margin-bottom:10px;
}

footer p{

    color:#94A3B8;

    margin-top:10px;
}

/* =========================
   MOBILE
========================= */

@media(max-width:768px){

    .project-card{

        flex-direction:column;
    }

    .about h2,
    .skills h2,
    .projects h2,
    .contact h2{

        font-size:2.2rem;
    }

    .project-content h3{

        font-size:1.6rem;
    }

    .contact-links{

        flex-direction:column;
        align-items:center;
    }
}
